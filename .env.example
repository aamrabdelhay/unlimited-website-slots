# Shared platform database (works with Neon, Supabase, or local PostgreSQL).
# Required only for database-backed website features — the dashboard and
# empty slots render fine without it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set to "true" for TLS-required providers (Neon, Supabase pooled connections).
DATABASE_SSL=false

# Optional per-slot dedicated database connections.
# Convention: SLOT_<six-digit padded slot id>_DATABASE_URL takes precedence
# over DATABASE_URL for that slot only (see README → Database architecture).
# SLOT_000003_DATABASE_URL=
# SLOT_000127_DATABASE_URL=
