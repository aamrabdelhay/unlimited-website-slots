# Shared platform database (works with Neon, Supabase, or local PostgreSQL).
# Required only for database-backed website features — the dashboard and empty slots render without it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_SSL=false

# Admin password for the private /admin custom-links dashboard (minimum 16 characters).
UNLIMITED_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Vercel adds BLOB_READ_WRITE_TOKEN automatically when the private custom-links store is connected.
# SLOT_000003_DATABASE_URL=
# SLOT_000127_DATABASE_URL=
